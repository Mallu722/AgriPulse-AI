# =============================================================================
# AgriPulse AI — Environment Variables Template
# =============================================================================
# Copy this file to backend/.env and frontend/.env.local
# Replace placeholder values with your actual credentials.
# NEVER commit .env files with real secrets to version control.
# =============================================================================

# --- Backend (backend/.env) ---

# PostgreSQL connection string
# Format: postgresql+psycopg://user:password@host:port/database
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD_HERE@localhost:5432/agripulse

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# LLM Provider (optional — RAG assistant)
LLM_API_KEY=
LLM_MODEL=
LLM_PROVIDER=

# IMD Weather API (optional — requires approved credentials)
IMD_API_KEY=

# Text-to-Speech Provider
TTS_PROVIDER=google
# Path to Google Cloud service account JSON (for Kannada TTS)
GOOGLE_APPLICATION_CREDENTIALS=

# --- Frontend (frontend/.env.local) ---

# VITE_API_BASE_URL=http://localhost:8000/api/v1
# WARNING: Never put API keys in VITE_ variables — they are bundled into
# the browser build and visible to anyone who inspects the page source.
